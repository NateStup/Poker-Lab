DATABASE_URL=postgres://pokerlab:pokerlab_dev@localhost:5432/pokerlab

# Signs the session cookie. Optional locally -- config.js falls back to a
# known development value -- but the server refuses to start in production
# without it, rather than signing sessions with a public default.
SESSION_SECRET=

# How long a session lasts, in milliseconds. Defaults to 30 days.
SESSION_TTL_MS=
