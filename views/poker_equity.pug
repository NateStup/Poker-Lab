extends layout

block content
  .calculator-shell
    .hero-card
      h1= title
    

      form#poker-form.card-form
        .field-row
          .field-group
            label(for='p1') Player A hole cards
            button.picker-target(type='button', data-target='p1')
              span Pick cards
              span#p1-preview.preview-text No cards selected
            input#p1(type='hidden', name='p1', data-max-cards='2')
          .field-group
            label(for='p2') Player B hole cards
            button.picker-target(type='button', data-target='p2')
              span Pick cards
              span#p2-preview.preview-text No cards selected
            input#p2(type='hidden', name='p2', data-max-cards='2')
        .field-row
          .field-group
            label(for='flop') Flop (optional)
            button.picker-target(type='button', data-target='flop')
              span Pick cards
              span#flop-preview.preview-text No cards selected
            input#flop(type='hidden', name='flop', data-max-cards='3')
          .field-group
            label(for='turn') Turn (optional)
            button.picker-target(type='button', data-target='turn')
              span Pick cards
              span#turn-preview.preview-text No cards selected
            input#turn(type='hidden', name='turn', data-max-cards='1')
        .card-picker-panel
          h3 Select cards
          p Choose cards from the grid below. Each selection is added to the highlighted field.
          #card-picker.card-picker
        .field-group
          label(for='iterations') Simulations
          input#iterations(type='number', name='iterations', value='2000', min='100', step='100')
        button(type='submit') Calculate Equity

      pre#results.result-box

  script(type='module', src='/javascripts/poker/app.js?v=20260801')
